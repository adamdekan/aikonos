# Keep the Docker build context small. The broker build needs go.mod, go.sum,
# the broker/ source, and proto/ — the gen/go/ stubs are generated in-image
# (H6), so host gen/ is excluded to keep the in-image stubs authoritative.
.vm/
.git/
bin/
gen/
talos/clusterconfig/
planner/.venv/
# The Windows app; no image builds from it, and its target/ runs to gigabytes.
desktop/
**/__pycache__/
*.log
# Secrets and key material never enter a build context: the broker builder
# runs COPY . ., which keeps whatever is here in its cached layers. `.env.*`
# also matches the .example templates; no image needs them.
**/.env
**/.env.*
**/*.key
**/*.pem
deploy/compose/tls/
backups/
.claude/
