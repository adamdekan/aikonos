# deploy/compose/.env.onprem.example
#
# On-premises enterprise test deployment template for on-prem.
# Copy to the repo root AS .env before running any compose or seed commands:
#
#   cp deploy/compose/.env.onprem.example ~/apps/aikonos/.env
#   # Edit .env — fill every <...> placeholder and rotate every *-CHANGE-ME secret.
#
# Why root .env (not --env-file): seed scripts call `docker compose` internally
# and would otherwise miss the overlay and secrets. The COMPOSE_FILE / COMPOSE_PROFILES
# vars below make every bare `docker compose` auto-apply the on-prem overlay.
#
# Secrets to generate:
#   openssl rand -hex 32    → POSTGRES_PASSWORD, MINIO_ROOT_PASSWORD, VAULT_DEV_ROOT_TOKEN_ID,
#                              AIKONOS_AUDIT_SIGNING_KEY, AIKONOS_CAPABILITY_ROOT_KEY,
#                              AIKONOS_API_KEY_PEPPER
#   openssl rand -base64 32 → OAUTH2_PROXY_COOKIE_SECRET  (must be 16/24/32 raw bytes, base64)

# ── Compose wiring ─────────────────────────────────────────────────────────────
COMPOSE_FILE=compose.yaml:deploy/compose/compose.onprem.yaml
COMPOSE_PROFILES=core

# ── Ingress ────────────────────────────────────────────────────────────────────
# Primary FQDN — must be in the Traefik TLS certificate SANs.
# Verify: openssl x509 -in /path/to/server.crt -noout -ext subjectAltName
AIKONOS_FQDN=aikonos.example.com

# External API FQDN for the agent SDK surface (API-key auth, no browser cookie).
# Must also be in the TLS certificate SANs. If the cert only covers AIKONOS_FQDN,
# set this to the same value and route the external API by path (advanced; requires
# a router rule adjustment in compose.onprem.yaml).
AIKONOS_API_FQDN=aikonos-api.example.com

# ── Entra ID tenant (app-native OIDC — no oauth2-proxy in this variant) ───────
# Directory (tenant) ID GUID — same value for ENTRA_TENANT_ID, AIKONOS_TENANT_ID,
# AIKONOS_OIDC_ISSUER, AIKONOS_OIDC_JWKS_URL, and the webui OIDC authority.
ENTRA_TENANT_ID=<ENTRA_TENANT_ID>

# DEPRECATED (no oauth2-proxy in the on-prem variant): the SPA performs Entra
# OIDC auth-code+PKCE itself and the broker validates every bearer server-side
# (see deploy/onprem/README.md "Entra app registration" — only one app
# registration is needed). These vars are unused by compose.onprem.yaml; kept
# commented for anyone migrating from the azure overlay, which still uses
# oauth2-proxy as a tenant-gate edge proxy.
# OAUTH2_PROXY_CLIENT_ID=<OAUTH2_PROXY_APP_CLIENT_ID>
# OAUTH2_PROXY_CLIENT_SECRET=<OAUTH2_PROXY_APP_CLIENT_SECRET-CHANGE-ME>
# OAUTH2_PROXY_COOKIE_SECRET=<COOKIE_SECRET-CHANGE-ME>

# ── Postgres ────────────────────────────────────────────────────────────────────
POSTGRES_USER=aikonos
POSTGRES_PASSWORD=<POSTGRES_PASSWORD-CHANGE-ME>
# Password for the non-superuser broker role aikonos_app (RLS enforcement).
# Distinct from POSTGRES_PASSWORD; generate with: openssl rand -hex 32
AIKONOS_DB_APP_PASSWORD=<AIKONOS_DB_APP_PASSWORD-CHANGE-ME>
# Password for the SELECT-only role aikonos_grafana (LLM Spend dashboard).
AIKONOS_GRAFANA_DB_PASSWORD=<AIKONOS_GRAFANA_DB_PASSWORD-CHANGE-ME>
POSTGRES_DB=aikonos

# ── MinIO (WORM audit) ─────────────────────────────────────────────────────────
MINIO_ROOT_USER=aikonosaudit
MINIO_ROOT_PASSWORD=<MINIO_PASSWORD-CHANGE-ME>

# ── Vault (dev-inmem) ──────────────────────────────────────────────────────────
# Still dev-mode in-memory — wiped on Vault restart. Re-run
# scripts/compose-vault-seed.sh after any Vault restart (or `task compose:seed`).
VAULT_DEV_ROOT_TOKEN_ID=<VAULT_ROOT_TOKEN-CHANGE-ME>

# ── Keycloak (idle on on-prem — kept only to satisfy depends_on; not the IdP) ──
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=<KEYCLOAK_ADMIN_PASSWORD-CHANGE-ME>

# ── Broker ─────────────────────────────────────────────────────────────────────
# A stable short name for the tenant used in admin FGA tuples (not the Entra tid).
AIKONOS_BROKER_TENANT_ID=aikonos-dev
# RLS / seed tenant = your Entra tid GUID (must match ENTRA_TENANT_ID above).
AIKONOS_TENANT_ID=<ENTRA_TENANT_ID>

# Auto-populated by scripts/compose-seed-openfga.sh.
# Broker refuses to start with AIKONOS_DEV_MODE=false until this is set.
AIKONOS_POLICY_OPENFGA_STORE_ID=

# ── OIDC: Microsoft Entra ID (single-tenant) ──────────────────────────────────
# No split-horizon needed: Entra is one public URL reachable by both the browser
# and the broker container.
AIKONOS_OIDC_ISSUER=https://login.microsoftonline.com/<ENTRA_TENANT_ID>/v2.0
# IMPORTANT — the ?appid=<client_id> suffix is REQUIRED for Entra ID tokens.
# Entra signs ID tokens (aud=client_id) with an app-specific key that is ONLY
# published by the JWKS endpoint when ?appid=<client_id> is present. Without it
# the keyset returns the generic access-token keys and every token is rejected
# with "no applicable key found in the JSON Web Key Set" → 401 on every request.
# <client_id> here is the SPA app registration's client ID (same as the audience).
AIKONOS_OIDC_JWKS_URL=https://login.microsoftonline.com/<ENTRA_TENANT_ID>/discovery/v2.0/keys?appid=<WEBUI_APP_CLIENT_ID>
# v2 access-token audience = the webui/API app client ID (the SPA app registration).
AIKONOS_OIDC_AUDIENCE=<WEBUI_APP_CLIENT_ID>
# Entra: oid is the stable subject, tid is the tenant.
AIKONOS_OIDC_SUBJECT_CLAIM=oid
AIKONOS_OIDC_TENANT_CLAIM=tid

# ── Datastore endpoints (unchanged from local) ─────────────────────────────────
AIKONOS_NATS_URL=nats://nats:4222
AIKONOS_VAULT_ADDR=http://vault:8200
# MUST stay false in production: unseal manually so unseal keys never touch disk
# (docs/OPS-RUNBOOK.md "Vault operations — first boot"). The vault-init sidecar
# no-ops when this is not "true".
AIKONOS_VAULT_AUTO_UNSEAL=false
AIKONOS_VAULT_ROLE=aikonos-broker
AIKONOS_VAULT_AUTH_METHOD=approle
# Provisioned into this file by scripts/compose-vault-seed.sh.
AIKONOS_VAULT_ROLE_ID=
AIKONOS_VAULT_SECRET_ID=

# ── Audit (MinIO WORM) ─────────────────────────────────────────────────────────
AIKONOS_AUDIT_MINIO_ENDPOINT=minio:9000
AIKONOS_AUDIT_BUCKET=aikonos-audit
AIKONOS_AUDIT_ACCESS_KEY=aikonosaudit
AIKONOS_AUDIT_SECRET_KEY=<MINIO_PASSWORD-CHANGE-ME>
# Generate: openssl rand -hex 32
AIKONOS_AUDIT_SIGNING_KEY=<AUDIT_SIGNING_KEY-CHANGE-ME>
AIKONOS_AUDIT_RETENTION_DAYS=365
# HMAC key for .agent/Sessions/* integrity sidecars (CP4.2) — Vault
# read-or-create is the normal path; this is only the fallback when Vault is
# unavailable at startup. Generate: openssl rand -hex 32
AIKONOS_WORKSPACE_SESSION_SIGNING_KEY=<WORKSPACE_SESSION_SIGNING_KEY-CHANGE-ME>

AIKONOS_OTEL_ENDPOINT=

# ── Grafana MCP server (--profile mcp-grafana, optional) ──────────────────────
# Gives agents read-only access to the company Grafana. The broker also needs
# AIKONOS_TOOLPROXY_MCP_ALLOW_PRIVATE=true to dial it over the mesh — see
# deploy/onprem/README.md "Attaching the Grafana MCP server".
AIKONOS_GRAFANA_MCP_URL=https://dashboards.example.com
# Grafana → Administration → Users and access → Service accounts → Add token.
# Give the account the Viewer role; --disable-write is set on the server too.
AIKONOS_GRAFANA_MCP_TOKEN=<GRAFANA_SERVICE_ACCOUNT_TOKEN-CHANGE-ME>
# PEM chain for the CA that issued Grafana's cert. Grafana serves an
# internally-issued leaf and sends no intermediate, so the chain must be
# supplied — the service-account token above travels over this connection.
# AIKONOS_GRAFANA_MCP_CA_FILE=./deploy/compose/tls/grafana-ca.crt

# ── Connector OAuth apps (optional) ───────────────────────────────────────────
# Redirect URI must use the public FQDN.
AIKONOS_CONNECTORS_REDIRECT_URI=https://aikonos.example.com/connect/callback
AIKONOS_CONNECTORS_GOOGLE_CLIENT_ID=
AIKONOS_CONNECTORS_GOOGLE_CLIENT_SECRET=
AIKONOS_CONNECTORS_MICROSOFT_CLIENT_ID=
AIKONOS_CONNECTORS_MICROSOFT_TENANT=common
AIKONOS_CONNECTORS_MICROSOFT_CLIENT_SECRET=

# ── Security keys ──────────────────────────────────────────────────────────────
# REQUIRED for AIKONOS_DEV_MODE=false — broker won't start without this.
# Generate: openssl rand -hex 32
AIKONOS_CAPABILITY_ROOT_KEY=<CAPABILITY_ROOT_KEY-CHANGE-ME>

# Fail-closed enterprise mode. Broker refuses to start unless OIDC + OpenFGA
# store + capability root key are all configured.
AIKONOS_DEV_MODE=false

# ── mTLS (dev-CA output from scripts/compose-dev-ca.sh) ───────────────────────
AIKONOS_BROKER_TLS_CERT_FILE=./deploy/compose/tls/broker.crt
AIKONOS_BROKER_TLS_KEY_FILE=./deploy/compose/tls/broker.key
AIKONOS_BROKER_TLS_CA_FILE=./deploy/compose/tls/ca.crt

# ── Office document tools (docx/xlsx/pptx/pdf) ────────────────────────────────
# office-worker is a broker dependency that
# always starts alongside it under the core/full profile, so the URL is
# populated on every variant. Empty → office.* toolproxy plugins report
# unavailable (Available(cfg) gate) instead of failing.
AIKONOS_OFFICE_WORKER_URL=http://office-worker:8081
AIKONOS_OFFICE_JOB_TIMEOUT_MS=120000
AIKONOS_OFFICE_MAX_CONCURRENCY=4

# ── Agent-gateway ──────────────────────────────────────────────────────────────
# LLM provider API key — seeded into Vault as the default provider.
# Leave empty to seed the provider without a key (set it later in Admin → LLM Providers).
OPENROUTER_API_KEY=
AIKONOS_LLM_PROVIDERS_SEED_FILE=
AIKONOS_PROVISIONING_SEED_FILE=
AIKONOS_LLM_MODEL=anthropic/claude-sonnet-4.6
AIKONOS_BROKER_NORTH_ADDR=broker:9090
AIKONOS_BROKER_SOUTH_ADDR=broker:9091
AIKONOS_BROKER_SERVER_NAME=broker
AIKONOS_TLS_CERT=/tls/agent-gateway.crt
AIKONOS_TLS_KEY=/tls/agent-gateway.key
AIKONOS_TLS_CA=/tls/ca.crt
AIKONOS_GATEWAY_SPIFFE_ID=spiffe://aikonos.com/agent-gateway

# Keycloak ROPC path is dead on this deployment (Entra is the IdP). These remain
# because the base compose still references them; harmless while Keycloak idles.
AIKONOS_KEYCLOAK_URL=http://keycloak:8080
AIKONOS_KEYCLOAK_REALM=aikonos
AIKONOS_KEYCLOAK_CLIENT=aikonos-broker
AIKONOS_DEMO_PASSWORD=disabled-on-onprem

# ── Webui SPA: OIDC (auth-code + PKCE) ────────────────────────────────────────
# BUILD-TIME: these are baked into the SPA image by Vite.
# Any change requires: docker compose build webui
AIKONOS_WEBUI_OIDC_AUTHORITY=https://login.microsoftonline.com/<ENTRA_TENANT_ID>/v2.0
AIKONOS_WEBUI_OIDC_CLIENT=<WEBUI_APP_CLIENT_ID>
AIKONOS_WEBUI_OIDC_REDIRECT_URI=https://aikonos.example.com/auth/callback
AIKONOS_WEBUI_OIDC_SCOPE=openid profile email
# Broker bearer = the ID token: this deployment's app exposes NO API (Graph
# User.Read only), so the access token would target Graph (wrong aud). The ID token
# carries aud=<client-id>, and requires the ?appid=<client-id> suffix on
# AIKONOS_OIDC_JWKS_URL above (the app-specific ID-token signing key). OneDrive OBO
# is unavailable in this model — to enable it, expose an API on the app, request
# api://<client-id>/.default, and set this back to "access".
AIKONOS_WEBUI_OIDC_TOKEN=id

AIKONOS_SMOKE_CLIENT_SECRET=unused-on-onprem

AIKONOS_SCHEDULER_ENABLED=false
AIKONOS_SCHEDULER_TICK_MS=30000

# F3: HMAC pepper for agent API-key hashing (broker + gateway).
# REQUIRED to mint agent API keys. Generate: openssl rand -hex 32
AIKONOS_API_KEY_PEPPER=<API_KEY_PEPPER-CHANGE-ME>
AIKONOS_EXTERNAL_PORT=8090
AIKONOS_EXTERNAL_CORS_ORIGINS=https://aikonos.example.com
AIKONOS_EXTERNAL_RATE_LIMIT=60

# Per-user child pool.
AIKONOS_GATEWAY_CHILD_KEYING=per-user
AIKONOS_GATEWAY_CHILD_TTL_MS=1800000
AIKONOS_GATEWAY_MAX_CHILDREN=8

# spawn_subagents fan-out: MAX_WIDTH caps concurrent branch children per call
# (fails fast, never queues); BRANCH_TIMEOUT_MS bounds each branch's wall
# clock. Keep MAX_WIDTH meaningfully below MAX_CHILDREN above — one fan-out at
# width==MAX_CHILDREN would consume the entire interactive child pool.
AIKONOS_GATEWAY_SUBAGENT_MAX_WIDTH=3
AIKONOS_GATEWAY_SUBAGENT_BRANCH_TIMEOUT_MS=180000

# Automated agent behavioral baseline learning.
AIKONOS_BASELINE_ENABLED=true
AIKONOS_BASELINE_WINDOW_SECONDS=60
AIKONOS_BASELINE_LEARN_INTERVAL_SECONDS=3600
AIKONOS_BASELINE_MIN_SAMPLE_WINDOWS=30
AIKONOS_BASELINE_DRIFT_MULTIPLIER=2.0
AIKONOS_BASELINE_RETENTION_WINDOWS=10080

# ── Obs stack (--profile obs) ──────────────────────────────────────────────────
AIKONOS_OBS_ARCHIVE=file
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=<GRAFANA_ADMIN_PASSWORD-CHANGE-ME>
