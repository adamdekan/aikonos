# deploy/compose/.env.example
# Copy to repo root as .env before running compose:
#   cp deploy/compose/.env.example .env
#
# DEV PLACEHOLDERS ONLY — do not use these values outside a local dev machine.
# Lines marked REQUIRED must be filled in before compose up will work.

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_USER=aikonos
POSTGRES_PASSWORD=dev-password-change-me
# Password for the non-superuser broker role aikonos_app (RLS enforcement).
# migrate.sh provisions the role with this; the broker connects as it.
AIKONOS_DB_APP_PASSWORD=dev-app-password-change-me
# Password for the SELECT-only role aikonos_grafana (LLM Spend dashboard).
AIKONOS_GRAFANA_DB_PASSWORD=dev-grafana-password-change-me
POSTGRES_DB=aikonos

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin-secret-change-me

# ── Vault (durable file storage + auto-unseal) ────────────────────────────────
# Local dev now runs Vault on durable `file` storage so KV (LLM keys, connector
# OAuth tokens, capability + audit keys) survives restart. The vault-init sidecar
# auto-inits and auto-unseals on every `up`; init/unseal material is persisted to
# the vault-data volume (dev only — never for azure/onprem). Reset = down -v.
# Set to anything but "true" to require manual unseal (enterprise posture).
AIKONOS_VAULT_AUTO_UNSEAL=true

# ── Keycloak ─────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=dev-admin-change-me

# ── Broker ───────────────────────────────────────────────────────────────────
AIKONOS_BROKER_TENANT_ID=aikonos-dev
AIKONOS_TENANT_ID=11111111-1111-1111-1111-111111111111
# OpenFGA store id. Empty → broker runs in dev allow-all stub mode (ReBAC not
# enforced). Populate it by running `scripts/compose-seed-openfga.sh` after the
# stack is up, then `docker compose up -d broker`.
AIKONOS_POLICY_OPENFGA_STORE_ID=
# Split-horizon issuer: the browser performs auth-code+PKCE against Keycloak at
# http://localhost:18080, so tokens carry iss=http://localhost:18080/realms/aikonos.
# The broker validates `iss` against this browser-facing URL but fetches the JWKS
# over the container network (AIKONOS_OIDC_JWKS_URL) — the broker's OIDC validator
# decouples the two (an explicit JWKS URL skips OIDC discovery).
AIKONOS_OIDC_ISSUER=http://localhost:18080/realms/aikonos
AIKONOS_OIDC_JWKS_URL=http://keycloak:8080/realms/aikonos/protocol/openid-connect/certs
AIKONOS_OIDC_AUDIENCE=aikonos-broker
# Principal + tenant claim names. The authz principal = the verified Subject
# (FGA operand + per-user storage key); audit actor stays the email. See
# . Keycloak: preferred_username/tenant_id —
# Subject = the username/email so dev-seed.yaml (keyed on emails) matches.
# (Keycloak's `sub` is an opaque, non-deterministic realm UUID — do NOT use it
# as the principal or every dev-seed tuple breaks.) Entra: oid/tid.
AIKONOS_OIDC_SUBJECT_CLAIM=preferred_username
AIKONOS_OIDC_TENANT_CLAIM=tenant_id
#
# ── Microsoft Entra ID (local) — use the dedicated template ───────────────────
# To run this LOCAL stack signed in with Entra instead of Keycloak, start from
# deploy/compose/.env.local-entra.example. It flips the OIDC vars above AND the
# webui bits that are easy to miss by hand — VITE_OIDC_TOKEN (id vs access), the
# JWKS ?appid= suffix, and the scope — and documents both the login-only and the
# tenant-OneDrive/OBO models. See docs/12-entra-login.md.
AIKONOS_NATS_URL=nats://nats:4222
AIKONOS_VAULT_ADDR=http://vault:8200
AIKONOS_VAULT_ROLE=aikonos-broker
# Vault auth: "approle" (compose default, least-privilege) or "kubernetes" (in-pod).
# ROLE_ID / SECRET_ID are provisioned into this file by scripts/compose-vault-seed.sh
# (run automatically by `task compose:seed`). The broker authenticates with this
# AppRole, bound to a policy scoped to only its own KV paths — never the root token.
AIKONOS_VAULT_AUTH_METHOD=approle
AIKONOS_VAULT_ROLE_ID=
AIKONOS_VAULT_SECRET_ID=
AIKONOS_AUDIT_MINIO_ENDPOINT=minio:9000
AIKONOS_AUDIT_BUCKET=aikonos-audit
AIKONOS_AUDIT_ACCESS_KEY=minioadmin
AIKONOS_AUDIT_SECRET_KEY=minioadmin-secret-change-me
# HMAC key for hash-chained audit events — change in any non-dev context
AIKONOS_AUDIT_SIGNING_KEY=dev-audit-hmac-key-change-me
AIKONOS_AUDIT_RETENTION_DAYS=365
# HMAC key for .agent/Sessions/* integrity sidecars (CP4.2) — used only when
# Vault is unavailable at startup (Vault read-or-create is the normal path,
# same as the capability/gateway-grant keys); change in any non-dev context.
AIKONOS_WORKSPACE_SESSION_SIGNING_KEY=ZGV2LXdvcmtzcGFjZS1zZXNzaW9uLWhtYWMta2V5LWNoYW5nZS1tZQ==
# OTel endpoint — empty disables tracing; set to otel-collector:4317 when running with --profile obs
AIKONOS_OTEL_ENDPOINT=
# AIKONOS_OTEL_ENDPOINT=otel-collector:4317
# Connector OAuth app credentials — leave empty to disable that provider
AIKONOS_CONNECTORS_REDIRECT_URI=http://localhost:3000/connect/callback
AIKONOS_CONNECTORS_GOOGLE_CLIENT_ID=
AIKONOS_CONNECTORS_GOOGLE_CLIENT_SECRET=
AIKONOS_CONNECTORS_MICROSOFT_CLIENT_ID=
AIKONOS_CONNECTORS_MICROSOFT_TENANT=common
AIKONOS_CONNECTORS_MICROSOFT_CLIENT_SECRET=
# Biscuit capability root key — empty = ephemeral per-process key (dev only)
AIKONOS_CAPABILITY_ROOT_KEY=
# Dev-mode guard: when false the broker refuses to start if OIDC / OpenFGA /
# capability-key are unconfigured. Set false in production.
AIKONOS_DEV_MODE=true
# TLS cert paths (dev-CA output from scripts/compose-dev-ca.sh)
AIKONOS_BROKER_TLS_CERT_FILE=./deploy/compose/tls/broker.crt
AIKONOS_BROKER_TLS_KEY_FILE=./deploy/compose/tls/broker.key
AIKONOS_BROKER_TLS_CA_FILE=./deploy/compose/tls/ca.crt

# ── Office document tools (docx/xlsx/pptx/pdf) ────────────────────────────────
# office-worker is a broker dependency that
# always starts alongside it under the core/full profile, so the URL is
# populated for every variant. Empty → office.* toolproxy plugins report
# unavailable (Available(cfg) gate) instead of failing.
AIKONOS_OFFICE_WORKER_URL=http://office-worker:8081
AIKONOS_OFFICE_JOB_TIMEOUT_MS=120000
AIKONOS_OFFICE_MAX_CONCURRENCY=4

# ── Agent-gateway ─────────────────────────────────────────────────────────────
# REQUIRED: set your OpenRouter key. F4: the broker also reads this at boot to
# seed the default `openrouter` LLM provider — the key is written to Vault
# (secret/data/providers/<tenant>/openrouter), never to Postgres. If unset, the
# provider seeds with no key (set it later in Admin → LLM Providers).
OPENROUTER_API_KEY=
# F4: path (inside the broker container) to the LLM provider seed YAML. Compose
# defaults it to /seed/llm-providers.yaml (bind-mounted from
# deploy/compose/llm-providers.yaml). Seeding is idempotent + upsert-if-absent:
# after first boot the DB/admin UI is authoritative. Empty disables seeding.
AIKONOS_LLM_PROVIDERS_SEED_FILE=
# Optional: path (inside the broker container) to a provisioning-rules seed YAML
# (email matcher -> FGA groups, applied at first login; see
# deploy/compose/provisioning.yaml.example). Idempotent, insert-if-matcher-absent.
# Empty (default) disables seeding; manage rules in Admin -> Provisioning instead.
AIKONOS_PROVISIONING_SEED_FILE=
AIKONOS_LLM_MODEL=anthropic/claude-sonnet-4.6
AIKONOS_BROKER_NORTH_ADDR=broker:9090
AIKONOS_BROKER_SOUTH_ADDR=broker:9091
# broker is the cert DNS-SAN (== compose service name); used for TLS hostname verification
AIKONOS_BROKER_SERVER_NAME=broker
AIKONOS_TLS_CERT=/tls/agent-gateway.crt
AIKONOS_TLS_KEY=/tls/agent-gateway.key
AIKONOS_TLS_CA=/tls/ca.crt
AIKONOS_GATEWAY_SPIFFE_ID=spiffe://aikonos.com/agent-gateway
# NOTE: ROPC token-minting (the demo-password path below) is removed in F2 CP3.
# The gateway will validate the browser's bearer and forward it instead of minting
# tokens, and Keycloak's direct-access-grants are disabled on both clients. These
# vars remain only until the gateway is cut over.
AIKONOS_KEYCLOAK_URL=http://keycloak:8080
AIKONOS_KEYCLOAK_REALM=aikonos
AIKONOS_KEYCLOAK_CLIENT=aikonos-broker
AIKONOS_DEMO_PASSWORD=dev
# Browser-facing OIDC for the webui SPA (auth-code+PKCE).
AIKONOS_WEBUI_OIDC_AUTHORITY=http://localhost:18080/realms/aikonos
AIKONOS_WEBUI_OIDC_CLIENT=aikonos-webui
AIKONOS_WEBUI_OIDC_REDIRECT_URI=http://localhost:4200/auth/callback
# Which token the SPA sends as the broker bearer. Keycloak stamps aud=aikonos-broker
# on the access token, so it must be "access". (Entra: "access" if the app exposes
# an API, "id" for a login-only app with no API — see .env.local-entra.example.)
AIKONOS_WEBUI_OIDC_TOKEN=access
# TEST-ONLY: secret for the confidential aikonos-smoke client that
# scripts/compose-verify.sh uses to mint real bearer tokens (ROPC is disabled on
# the user-facing clients). Must match the client secret in keycloak-realm.json.
AIKONOS_SMOKE_CLIENT_SECRET=smoke-secret-local-dev
AIKONOS_SCHEDULER_ENABLED=false
AIKONOS_SCHEDULER_TICK_MS=30000
# F3: external agent endpoint — HMAC pepper for API key hashing (broker + gateway).
# Set to a random secret, e.g. `openssl rand -hex 32`. Empty = fail-closed:
# minting an agent API key returns FAILED_PRECONDITION (api key pepper not
# configured), so external endpoints are unusable until this is set. Never stored
# in the DB; rotating it invalidates every existing agent API key.
AIKONOS_API_KEY_PEPPER=
# F3: external port the gateway exposes for unauthenticated-then-API-key-verified
# agent invocations (/v1/agents/:id/invoke). Default 8090.
AIKONOS_EXTERNAL_PORT=8090
# F3: comma-separated origins for the external CORS policy (e.g. https://myapp.com).
# Empty allows no CORS preflight (API clients use direct calls).
AIKONOS_EXTERNAL_CORS_ORIGINS=
# F3: per-IP requests-per-minute rate limit on the external port. Default 60.
AIKONOS_EXTERNAL_RATE_LIMIT=60
# H3 Phase 3 (live): per-user child pool is the production default — both the
# code default (F28) and this compose var agree. Each (tenantId,userId,agentId)
# triple gets its own forked child process — cross-user heap isolation. "single"
# remains a valid opt-in (one shared child for all identities). TTL controls
# idle-child eviction (ms). MAX_CHILDREN caps the pool (LRU eviction when full;
# 503 when all busy and at cap). Sizing: parent ~400 MB + N × ~300 MB per child;
# compose mem_limit:4g supports N=8 with headroom. Raise MAX_CHILDREN only after
# confirming pids_limit:512 still holds.
# Phase 4 residual: /tls SVID is world-readable at the same uid — distinct child
# uid (OS-level separation) is a future non-goal.
AIKONOS_GATEWAY_CHILD_KEYING=per-user
AIKONOS_GATEWAY_CHILD_TTL_MS=1800000
AIKONOS_GATEWAY_MAX_CHILDREN=8

# spawn_subagents fan-out: MAX_WIDTH caps concurrent branch children per call
# (fails fast, never queues); BRANCH_TIMEOUT_MS bounds each branch's wall
# clock. Keep MAX_WIDTH meaningfully below MAX_CHILDREN above — one fan-out at
# width==MAX_CHILDREN would consume the entire interactive child pool.
AIKONOS_GATEWAY_SUBAGENT_MAX_WIDTH=3
AIKONOS_GATEWAY_SUBAGENT_BRANCH_TIMEOUT_MS=180000

# Automated agent behavioral baseline learning
#. Monitoring only — never blocks a
# call. WINDOW_SECONDS is the flush+detect tick and the observation bucket
# size; LEARN_INTERVAL_SECONDS is how often the learned envelope is
# recomputed; MIN_SAMPLE_WINDOWS gates drift emission until a baseline is
# mature; DRIFT_MULTIPLIER sets the rate-drift ceiling; RETENTION_WINDOWS
# bounds how many windows are kept/aggregated.
AIKONOS_BASELINE_ENABLED=true
AIKONOS_BASELINE_WINDOW_SECONDS=60
AIKONOS_BASELINE_LEARN_INTERVAL_SECONDS=3600
AIKONOS_BASELINE_MIN_SAMPLE_WINDOWS=30
AIKONOS_BASELINE_DRIFT_MULTIPLIER=2.0
AIKONOS_BASELINE_RETENTION_WINDOWS=10080

# Webui talks only to the gateway (GATEWAY_URL / OBSERVABILITY_URL are set
# directly on the webui service in compose.yaml; the live audit SSE is served by
# the gateway at /api/audit/stream). The legacy frontend / admin / observability
# consoles were removed — the unified webui is the only UI.

# ── Obs stack (--profile obs) ─────────────────────────────────────────────────
# Archive sink: file (default, zero deps) | s3 (S3-compatible) | azure (Azure Blob native) | siem (generic OTLP-HTTP)
AIKONOS_OBS_ARCHIVE=file

# Host path the otel-collector tails for container logs (filelog → Loki). Must be
# the Docker daemon's <data-root>/containers dir. Override only when the data-root
# is relocated off /var/lib/docker (check: `docker info --format '{{.DockerRootDir}}'`).
# AIKONOS_DOCKER_CONTAINERS_DIR=/data/docker/containers

# Grafana admin credentials (obs profile)
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin-change-me

# S3-compatible archive settings (used when AIKONOS_OBS_ARCHIVE=s3)
# OBS_S3_REGION=us-east-1
# OBS_S3_BUCKET=aikonos-obs
# OBS_S3_ENDPOINT=          # empty = AWS; set to http://minio:9000 for in-compose MinIO
# OBS_ACCESS_KEY_ID=
# OBS_SECRET_ACCESS_KEY=

# Azure Blob archive settings (used when AIKONOS_OBS_ARCHIVE=azure)
# Uses the native azureblobexporter; no S3-compatible endpoint required.
# Auth via connection string (default) or an Azure identity — set AIKONOS_OBS_AZURE_AUTH_TYPE.
# The exporter (collector 0.130.0) supports exactly these four types; there is no
# federated "workload_identity" type — for AKS/host workload identity use
# system_managed_identity.
# AIKONOS_OBS_AZURE_AUTH_TYPE=connection_string   # connection_string | system_managed_identity | user_managed_identity | service_principal
#
# connection_string auth — carries its own endpoint:
# AIKONOS_OBS_AZURE_CONNECTION_STRING=            # e.g. DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
#
# Identity auth (system/user managed identity, service principal) — set the blob
# endpoint (required for every type except connection_string):
# AIKONOS_OBS_AZURE_ACCOUNT_URL=                  # https://<account>.blob.core.windows.net/
# AIKONOS_OBS_AZURE_CLIENT_ID=                    # user_managed_identity + service_principal
# AIKONOS_OBS_AZURE_TENANT_ID=                    # service_principal only
# AIKONOS_OBS_AZURE_CLIENT_SECRET=                # service_principal only

# SIEM export settings (used when AIKONOS_OBS_ARCHIVE=siem)
# Generic OTLP-HTTP forward — Splunk/Datadog/Elastic all ingest OTLP natively,
# so no vendor-specific exporter is needed. Runs ALONGSIDE the local Tempo/Loki
# dashboards, not instead of them.
# AIKONOS_SIEM_OTLP_ENDPOINT=                     # e.g. https://siem.example:4318
# AIKONOS_SIEM_OTLP_AUTH_HEADER=                  # full header value, e.g. "Bearer <token>"; empty = no auth

# DEV ONLY: let the broker-side MCP client reach private-IP MCP servers — needed
# for the mcp-echo test service (compose mesh IPs are private). Default false;
# never enable in production (it disables the MCP SSRF guard).
# AIKONOS_TOOLPROXY_MCP_ALLOW_PRIVATE=true

# Grafana MCP server (--profile mcp-grafana). Both are required to start that
# profile; the CA file is only needed when Grafana's cert is internally issued.
# See deploy/onprem/README.md "Attaching the Grafana MCP server".
# AIKONOS_GRAFANA_MCP_URL=https://grafana.example
# AIKONOS_GRAFANA_MCP_TOKEN=<grafana service account token>
# AIKONOS_GRAFANA_MCP_CA_FILE=./deploy/compose/tls/grafana-ca.crt
