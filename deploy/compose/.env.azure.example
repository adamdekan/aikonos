# deploy/compose/.env.azure.example
#
# Enterprise / Azure VM deployment template. Copy to the repo root ON THE VM as
# `.env` (the active env), then fill every <...> placeholder and rotate every
# *-CHANGE-ME secret:
#   cp deploy/compose/.env.azure.example .env
#
# Why root `.env` (not --env-file): the seed scripts call plain `docker compose`
# internally and would otherwise miss the overlay + secrets. The COMPOSE_FILE /
# COMPOSE_PROFILES vars below make every bare `docker compose` (and each seed
# script) auto-apply the azure overlay + core profile + these secrets.
#
# On a dev laptop that also runs the LOCAL stack, do NOT place this at root `.env`;
# use the Taskfile `:azure` targets (they pass --env-file .env.azure) instead.

# ── Compose wiring (azure) ─────────────────────────────────────────────────────
# Apply the base stack + the azure overlay (Traefik + oauth2-proxy) on every
# `docker compose` invocation, and default to the core profile.
COMPOSE_FILE=compose.yaml:deploy/compose/compose.azure.yaml
COMPOSE_PROFILES=core

# ── Edge / ingress (Traefik + oauth2-proxy) ───────────────────────────────────
# Public FQDN of the VM. Use the Azure Public IP DNS name label, e.g.
# aikonos-dev.westeurope.cloudapp.azure.com — Let's Encrypt validates it via HTTP-01.
AIKONOS_FQDN=<label>.westeurope.cloudapp.azure.com
# Host for the API-key external surface (agent SDK calls). A subdomain is cleanest;
# if you only have the cloudapp label, reuse AIKONOS_FQDN and route by path instead.
AIKONOS_API_FQDN=api.<label>.westeurope.cloudapp.azure.com
# Email for the Let's Encrypt ACME account (expiry notices).
ACME_EMAIL=admin@example.com

# oauth2-proxy ⇆ Entra (App B — the "Web" app registration; confidential client).
OAUTH2_PROXY_CLIENT_ID=<OAUTH2_PROXY_APP_CLIENT_ID>
OAUTH2_PROXY_CLIENT_SECRET=<OAUTH2_PROXY_APP_CLIENT_SECRET-CHANGE-ME>
# Generate: `openssl rand -base64 32` (must be 16/24/32 raw bytes, base64).
OAUTH2_PROXY_COOKIE_SECRET=<COOKIE_SECRET-CHANGE-ME>

# ── Entra tenant (shared by app-native OIDC + oauth2-proxy) ────────────────────
# Directory (tenant) ID GUID.
ENTRA_TENANT_ID=<TENANT_ID>

# ── Postgres ───────────────────────────────────────────────────────────────────
POSTGRES_USER=aikonos
POSTGRES_PASSWORD=<POSTGRES_PASSWORD-CHANGE-ME>
# Password for the non-superuser broker role aikonos_app (RLS enforcement).
# Distinct from POSTGRES_PASSWORD; generate with: openssl rand -hex 32
AIKONOS_DB_APP_PASSWORD=<AIKONOS_DB_APP_PASSWORD-CHANGE-ME>
# Password for the SELECT-only role aikonos_grafana (LLM Spend dashboard).
AIKONOS_GRAFANA_DB_PASSWORD=<AIKONOS_GRAFANA_DB_PASSWORD-CHANGE-ME>
POSTGRES_DB=aikonos

# ── MinIO (WORM audit) ─────────────────────────────────────────────────────────
MINIO_ROOT_USER=aikonosaudit
MINIO_ROOT_PASSWORD=<MINIO_PASSWORD-CHANGE-ME>

# ── Vault (dev-inmem) ──────────────────────────────────────────────────────────
# NOTE: still dev-mode in-memory on the VM — wiped on Vault restart, taking the
# AppRole + connector tokens with it. Re-run scripts/compose-vault-seed.sh after
# any Vault restart. Persistent Vault / Azure Key Vault is a prod-hardening item.
VAULT_DEV_ROOT_TOKEN_ID=<VAULT_ROOT_TOKEN-CHANGE-ME>

# ── Keycloak (idle on azure — kept only to satisfy depends_on; not the IdP) ─────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=<KEYCLOAK_ADMIN_PASSWORD-CHANGE-ME>

# ── Broker ───────────────────────────────────────────────────────────────────
AIKONOS_BROKER_TENANT_ID=aikonos-dev
# RLS/seed tenant = your Entra tid (per docs/12-entra-login.md).
AIKONOS_TENANT_ID=<TENANT_ID>
# Auto-populated by scripts/compose-seed-openfga.sh. Must be non-empty once
# DEV_MODE=false (broker refuses to boot otherwise).
AIKONOS_POLICY_OPENFGA_STORE_ID=

# ── OIDC: Microsoft Entra ID (single-tenant) ──────────────────────────────────
# No split-horizon: Entra is one public URL for browser AND containers.
AIKONOS_OIDC_ISSUER=https://login.microsoftonline.com/<TENANT_ID>/v2.0
AIKONOS_OIDC_JWKS_URL=https://login.microsoftonline.com/<TENANT_ID>/discovery/v2.0/keys
# v2 access-token aud = the webui/API app's client id (App A).
AIKONOS_OIDC_AUDIENCE=<WEBUI_APP_CLIENT_ID>
# Entra: oid is the stable principal, tid the tenant.
AIKONOS_OIDC_SUBJECT_CLAIM=oid
AIKONOS_OIDC_TENANT_CLAIM=tid

# ── Datastore endpoints (unchanged from local) ────────────────────────────────
AIKONOS_NATS_URL=nats://nats:4222
AIKONOS_VAULT_ADDR=http://vault:8200
# MUST stay false in production: unseal manually so unseal keys never touch disk
# (docs/OPS-RUNBOOK.md "Vault operations — first boot"). The vault-init sidecar
# no-ops when this is not "true".
AIKONOS_VAULT_AUTO_UNSEAL=false
AIKONOS_VAULT_ROLE=aikonos-broker
AIKONOS_VAULT_AUTH_METHOD=approle
# Provisioned into this file by scripts/compose-vault-seed.sh.
AIKONOS_VAULT_ROLE_ID=
AIKONOS_VAULT_SECRET_ID=

# ── Audit (MinIO WORM) ─────────────────────────────────────────────────────────
AIKONOS_AUDIT_MINIO_ENDPOINT=minio:9000
AIKONOS_AUDIT_BUCKET=aikonos-audit
AIKONOS_AUDIT_ACCESS_KEY=aikonosaudit
AIKONOS_AUDIT_SECRET_KEY=<MINIO_PASSWORD-CHANGE-ME>
# HMAC key for the hash-chained audit log — generate: `openssl rand -hex 32`.
AIKONOS_AUDIT_SIGNING_KEY=<AUDIT_SIGNING_KEY-CHANGE-ME>
AIKONOS_AUDIT_RETENTION_DAYS=365
# HMAC key for .agent/Sessions/* integrity sidecars (CP4.2) — Vault
# read-or-create is the normal path; this is only the fallback when Vault is
# unavailable at startup. Generate: `openssl rand -hex 32`.
AIKONOS_WORKSPACE_SESSION_SIGNING_KEY=<WORKSPACE_SESSION_SIGNING_KEY-CHANGE-ME>

AIKONOS_OTEL_ENDPOINT=

# Grafana MCP server (--profile mcp-grafana). Both are required to start that
# profile; the CA file is only needed when Grafana's cert is internally issued.
# Reaching it needs AIKONOS_TOOLPROXY_MCP_ALLOW_PRIVATE=true on the broker, which
# disables the MCP SSRF guard — do not enable on an internet-exposed tenant.
# AIKONOS_GRAFANA_MCP_URL=https://grafana.example
# AIKONOS_GRAFANA_MCP_TOKEN=<grafana service account token>
# AIKONOS_GRAFANA_MCP_CA_FILE=./deploy/compose/tls/grafana-ca.crt

# ── Connector OAuth apps (optional — leave empty to disable a provider) ────────
# Redirect URI must point at the public FQDN now, not localhost.
AIKONOS_CONNECTORS_REDIRECT_URI=https://<label>.westeurope.cloudapp.azure.com/connect/callback
AIKONOS_CONNECTORS_GOOGLE_CLIENT_ID=
AIKONOS_CONNECTORS_GOOGLE_CLIENT_SECRET=
AIKONOS_CONNECTORS_MICROSOFT_CLIENT_ID=
AIKONOS_CONNECTORS_MICROSOFT_TENANT=common
AIKONOS_CONNECTORS_MICROSOFT_CLIENT_SECRET=

# Biscuit capability root key — REQUIRED once DEV_MODE=false (broker won't boot
# without it). Generate a persistent key, e.g. `openssl rand -hex 32`.
AIKONOS_CAPABILITY_ROOT_KEY=<CAPABILITY_ROOT_KEY-CHANGE-ME>

# Enterprise: fail-closed. Broker refuses to start unless OIDC + OpenFGA store +
# capability key are all configured.
AIKONOS_DEV_MODE=false

# ── Broker TLS (dev-CA output from scripts/compose-dev-ca.sh) ──────────────────
AIKONOS_BROKER_TLS_CERT_FILE=./deploy/compose/tls/broker.crt
AIKONOS_BROKER_TLS_KEY_FILE=./deploy/compose/tls/broker.key
AIKONOS_BROKER_TLS_CA_FILE=./deploy/compose/tls/ca.crt

# ── Office document tools (docx/xlsx/pptx/pdf) ────────────────────────────────
# office-worker is a broker dependency that
# always starts alongside it under the core/full profile, so the URL is
# populated on every variant. Empty → office.* toolproxy plugins report
# unavailable (Available(cfg) gate) instead of failing.
AIKONOS_OFFICE_WORKER_URL=http://office-worker:8081
AIKONOS_OFFICE_JOB_TIMEOUT_MS=120000
AIKONOS_OFFICE_MAX_CONCURRENCY=4

# ── Agent-gateway ─────────────────────────────────────────────────────────────
# REQUIRED: real OpenRouter key (also seeded into Vault as the default provider).
OPENROUTER_API_KEY=<OPENROUTER_API_KEY-CHANGE-ME>
AIKONOS_LLM_PROVIDERS_SEED_FILE=
AIKONOS_PROVISIONING_SEED_FILE=
AIKONOS_LLM_MODEL=anthropic/claude-sonnet-4.6
AIKONOS_BROKER_NORTH_ADDR=broker:9090
AIKONOS_BROKER_SOUTH_ADDR=broker:9091
AIKONOS_BROKER_SERVER_NAME=broker
AIKONOS_TLS_CERT=/tls/agent-gateway.crt
AIKONOS_TLS_KEY=/tls/agent-gateway.key
AIKONOS_TLS_CA=/tls/ca.crt
AIKONOS_GATEWAY_SPIFFE_ID=spiffe://aikonos.com/agent-gateway

# Keycloak ROPC demo path is dead on azure (Entra is the IdP). These remain only
# because the base compose still references them; harmless while keycloak idles.
AIKONOS_KEYCLOAK_URL=http://keycloak:8080
AIKONOS_KEYCLOAK_REALM=aikonos
AIKONOS_KEYCLOAK_CLIENT=aikonos-broker
AIKONOS_DEMO_PASSWORD=disabled-on-azure

# Browser-facing OIDC for the webui SPA (auth-code+PKCE). BUILD-TIME: these flow
# into the webui image build args (compose.yaml webui.build.args). Changing them
# requires `docker compose build webui`.
AIKONOS_WEBUI_OIDC_AUTHORITY=https://login.microsoftonline.com/<TENANT_ID>/v2.0
AIKONOS_WEBUI_OIDC_CLIENT=<WEBUI_APP_CLIENT_ID>
AIKONOS_WEBUI_OIDC_REDIRECT_URI=https://<label>.westeurope.cloudapp.azure.com/auth/callback
AIKONOS_WEBUI_OIDC_SCOPE=openid profile api://<WEBUI_APP_CLIENT_ID>/access_as_user
# Broker bearer = access token: this app exposes an API, so the access token's aud
# is the client id. Use "id" only for a login-only app that exposes no API.
AIKONOS_WEBUI_OIDC_TOKEN=access

# Smoke client is Keycloak-only; compose:verify auto-detects Entra from the issuer
# and uses AIKONOS_ENTRA_SMOKE_TOKEN instead (see docs/12-entra-login.md).
AIKONOS_SMOKE_CLIENT_SECRET=unused-on-azure

AIKONOS_SCHEDULER_ENABLED=false
AIKONOS_SCHEDULER_TICK_MS=30000

# F3: external agent endpoint — HMAC pepper for API-key hashing. REQUIRED to mint
# agent API keys. Generate: `openssl rand -hex 32`.
AIKONOS_API_KEY_PEPPER=<API_KEY_PEPPER-CHANGE-ME>
AIKONOS_EXTERNAL_PORT=8090
# CORS origins for the external API (browser callers). Set to your FQDN(s).
AIKONOS_EXTERNAL_CORS_ORIGINS=https://<label>.westeurope.cloudapp.azure.com
AIKONOS_EXTERNAL_RATE_LIMIT=60

# Per-user child pool (production mode).
AIKONOS_GATEWAY_CHILD_KEYING=per-user
AIKONOS_GATEWAY_CHILD_TTL_MS=1800000
AIKONOS_GATEWAY_MAX_CHILDREN=8

# spawn_subagents fan-out: MAX_WIDTH caps concurrent branch children per call
# (fails fast, never queues); BRANCH_TIMEOUT_MS bounds each branch's wall
# clock. Keep MAX_WIDTH meaningfully below MAX_CHILDREN above — one fan-out at
# width==MAX_CHILDREN would consume the entire interactive child pool.
AIKONOS_GATEWAY_SUBAGENT_MAX_WIDTH=3
AIKONOS_GATEWAY_SUBAGENT_BRANCH_TIMEOUT_MS=180000

# Automated agent behavioral baseline learning.
AIKONOS_BASELINE_ENABLED=true
AIKONOS_BASELINE_WINDOW_SECONDS=60
AIKONOS_BASELINE_LEARN_INTERVAL_SECONDS=3600
AIKONOS_BASELINE_MIN_SAMPLE_WINDOWS=30
AIKONOS_BASELINE_DRIFT_MULTIPLIER=2.0
AIKONOS_BASELINE_RETENTION_WINDOWS=10080

# ── Obs stack (--profile obs) ──────────────────────────────────────────────────
AIKONOS_OBS_ARCHIVE=file
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=<GRAFANA_ADMIN_PASSWORD-CHANGE-ME>
