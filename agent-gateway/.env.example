# agent-gateway configuration (copy to .env; .env is gitignored)

# OpenRouter (the LLM provider the Pi agent uses)
OPENROUTER_API_KEY=sk-or-v1-...
AIKONOS_LLM_MODEL=anthropic/claude-sonnet-4.6

# Broker endpoints. Host-side dev uses kubectl port-forward:
#   kubectl port-forward -n aikonos-platform svc/broker 9090:9090 9091:9091
AIKONOS_BROKER_NORTH_ADDR=127.0.0.1:9090
AIKONOS_BROKER_SOUTH_ADDR=127.0.0.1:9091
# The broker SVID carries this DNS SAN; gRPC verifies the server against it.
AIKONOS_BROKER_SERVER_NAME=broker.aikonos-platform.svc.cluster.local

# File-based mTLS (a minted agent-gateway SVID + SPIRE bundle). Dev/host mode.
# In-cluster these are replaced by the SPIFFE Workload API (deferred).
AIKONOS_TLS_CERT=.svid/svid.pem
AIKONOS_TLS_KEY=.svid/key.pem
AIKONOS_TLS_CA=.svid/ca.pem
AIKONOS_GATEWAY_SPIFFE_ID=spiffe://aikonos.com/agent-gateway

# HTTP server (AG-UI endpoint)
PORT=8080

# Dev: a default tenant + OIDC token for CLI smokes (the frontend supplies these
# per-user in the real flow).
AIKONOS_TENANT_ID=11111111-1111-1111-1111-111111111111

# Scheduler (user-scheduled agentic runs). Disabled by default; the single
# in-cluster replica enables it. Ticker claims due runs from the broker and
# fires them unattended through the governed Pi session.
AIKONOS_SCHEDULER_ENABLED=false
AIKONOS_SCHEDULER_TICK_MS=30000
AIKONOS_SCHEDULER_CLAIM_LIMIT=10
AIKONOS_SCHEDULER_RUN_TIMEOUT_MS=180000
